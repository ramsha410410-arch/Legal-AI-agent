# ============================================================
# .env.example — Template for your secret configuration
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in YOUR actual values in the .env file
# 3. NEVER share your .env file or commit it to Git!
#    (It contains secret keys like passwords)
#
# WHY A .env FILE?
# Hardcoding secrets in your code is dangerous.
# If you share code, your keys get exposed.
# .env files keep secrets separate from code.
# ============================================================

# --- App Settings ---
APP_NAME="Legal AI Agent"
APP_VERSION="1.0.0"
DEBUG_MODE=False                # Set True to see detailed logs

# --- LLM Provider Choice ---
# Options: "ollama" (local/private) or "vertexai" (Google cloud)
DEFAULT_LLM_PROVIDER=ollama

# --- Ollama Settings ---
# Ollama runs on your computer, so it's always localhost
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b         # or: mistral, codellama, etc.
OLLAMA_TEMPERATURE=0.1          # 0=very precise, 1=very creative

# --- Google Vertex AI Settings ---
# You need a Google Cloud account and a project
# Get these from: https://console.cloud.google.com
GOOGLE_CLOUD_PROJECT=your-project-id-here
GOOGLE_CLOUD_REGION=us-central1
VERTEXAI_MODEL=gemini-1.5-pro   # Google's best model

# Path to your Google Cloud service account key (JSON file)
# Download from: GCP Console → IAM → Service Accounts → Keys
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# --- Vector Database Settings ---
CHROMA_DB_PATH=./data/chroma_db  # Where to store the local search index
LEGAL_DOCS_PATH=./data/legal_knowledge  # Folder with legal reference docs

# --- Security Settings ---
# A random secret key for the app (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-this-with-a-random-64-character-string

# Max file size for uploads (in MB)
MAX_UPLOAD_SIZE_MB=50

# --- Session Settings ---
SESSION_TIMEOUT_MINUTES=60
MAX_CONVERSATION_HISTORY=20     # How many messages to remember
